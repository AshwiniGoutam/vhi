# ─────────────────────────────────────────────────────────────
# VHI · environment variables. Copy to .env.local and fill in.
# Never commit real values. Integrations left blank fall back to
# safe development providers (mock payments, manual availability,
# console WhatsApp/email).
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=development                 # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=vhi

# Security (generate with: openssl rand -hex 32)
CRON_SECRET=

# First admin (used by `npm run seed` / `npm run create-admin`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vhi

# Razorpay (PAYMENT_PROVIDER=mock works without keys in development)
PAYMENT_PROVIDER=mock               # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# eZee channel manager (CHANNEL_MANAGER_PROVIDER=manual until credentials arrive)
CHANNEL_MANAGER_PROVIDER=manual     # manual | ezee
EZEE_API_URL=
EZEE_API_KEY=
EZEE_API_SECRET=
EZEE_HOTEL_CODE=

# WhatsApp
WHATSAPP_PROVIDER=console           # console | meta_cloud | interakt
WHATSAPP_ACCESS_TOKEN=              # Meta Cloud access token, or Interakt API key
WHATSAPP_PHONE_NUMBER_ID=           # Meta Cloud only
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email — choose ONE provider
#   resend : API (recommended) — EMAIL_API_KEY from resend.com, domain verified there
#   smtp   : any mailbox — Google Workspace/Gmail (app password), Zoho, Hostinger, Outlook…
#   console: development — emails are printed in the terminal
EMAIL_PROVIDER=console              # console | resend | smtp
EMAIL_FROM="VHI Luxury Homestays <bookings@yourdomain.com>"
EMAIL_REPLY_TO=                     # optional, e.g. stay@yourdomain.com
EMAIL_API_KEY=                      # resend only

SMTP_HOST=                          # e.g. smtp.gmail.com · smtp.zoho.in · smtp.hostinger.com
SMTP_PORT=465                       # 465 (SSL) or 587 (STARTTLS)
SMTP_SECURE=                        # leave empty to auto-detect from the port
SMTP_USER=                          # full mailbox address
SMTP_PASS=                          # mailbox password or app password

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=                  # Meta Conversions API
